    {
      "name": "conferma",
      "html": "<it-stepper current=\"1\" confirm-label=\"Conferma\" show-confirm=\"\">\n  <it-stepper-step icon=\"it-calendar\">\n    <span slot=\"label\">Primo contenuto</span>\n    <div class=\"p-5 text-center border bg-light\">\n      <p class=\"m-0\">Contenuto dello step 1</p>\n    </div>\n  </it-stepper-step>\n\n  <it-stepper-step icon=\"it-lock\">\n    <span slot=\"label\">Secondo contenuto</span>\n    <div class=\"p-5 text-center border bg-light\">\n      <p class=\"m-0\">Contenuto dello step 2</p>\n    </div>\n  </it-stepper-step>\n\n  <it-stepper-step icon=\"it-settings\">\n    <span slot=\"label\">Terzo contenuto</span>\n    <div class=\"p-5 text-center border bg-light\">\n      <p class=\"m-0\">Contenuto dello step 3</p>\n    </div>\n  </it-stepper-step>\n</it-stepper>"
