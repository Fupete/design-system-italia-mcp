e\">\n      <p class=\"m-0\">Contenuto dello step 2</p>\n    </div>\n  </it-stepper-step>\n\n  <it-stepper-step icon=\"it-settings\">\n    <span slot=\"label\">Terzo contenuto</span>\n    <div class=\"p-5 text-center border text-white\">\n      <p class=\"m-0\">Contenuto dello step 3</p>\n    </div>\n  </it-stepper-step>\n</it-stepper>"
